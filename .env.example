# Copy to .env and adjust. Every value is optional; the defaults are shown.
# Do NOT put credentials in this file. The Claude CLI reads its own
# authentication (ANTHROPIC_* variables or `claude` login) from the environment.

KNOWLEDGE_DIR=data/golden/knowledge_base
CHROMA_PATH=chroma_db
COLLECTION_NAME=helpdesk

TOP_K=5
MIN_SCORE=0.25

CLAUDE_BIN=claude
CLAUDE_TIMEOUT=120
MAX_CONCURRENT_REQUESTS=3

MAX_QUESTION_CHARS=500
INDEX_REFRESH_SECONDS=300
LOG_LEVEL=INFO

# --- Webhook receiver (webhook_receiver/) ---
# Replace the placeholders. Use a long random value for the secret, e.g.: python -c "import secrets; print(secrets.token_urlsafe(32))"
WEBHOOK_SECRET=<generate-a-random-string-of-at-least-16-characters>
TICKET_API_URL=http://127.0.0.1:9000
TICKET_API_KEY=<api-key-for-the-incident-system>
# SIGNATURE_TOLERANCE_SECONDS=300
# MAX_BODY_BYTES=65536
# TICKET_TIMEOUT_SECONDS=5
# TICKET_MAX_ATTEMPTS=3

# --- Mock incident system (mock_itsm/) ---
MOCK_ITSM_API_KEY=<same-value-as-TICKET_API_KEY-for-local-testing>
# MOCK_ITSM_DB=mock_itsm.db

# --- Agentic ticket creation (the helpdesk assistant -> webhook receiver) ---
# Uses WEBHOOK_SECRET above. Disabled automatically if the secret is missing or still a placeholder.
# AUTO_TICKET_ENABLED=true
# HELPDESK_WEBHOOK_URL=http://127.0.0.1:8000/webhooks/issues
# TICKET_WEBHOOK_TIMEOUT=15
# REQUIRE_TICKET_CONFIRMATION=true   # false = open tickets automatically without asking
